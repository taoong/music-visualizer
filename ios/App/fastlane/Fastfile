default_platform(:ios)

platform :ios do
  desc "Archive and upload the current build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_FILEPATH")
    )

    # Provision signing via the App Store Connect API key instead of an
    # Xcode-GUI Apple ID session — works headlessly, no login/2FA prompt.
    cert(
      api_key: api_key,
      team_id: "SL9MBFK93P"
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.taoong.musicvisualizer",
      team_id: "SL9MBFK93P",
      force: true
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      output_directory: "./build"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
