default_platform(:ios)

platform :ios do
  desc "Archive and upload the current build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_FILEPATH")
    )

    # Provision signing via the App Store Connect API key instead of an
    # Xcode-GUI Apple ID session — works headlessly, no login/2FA prompt.
    cert(
      api_key: api_key,
      team_id: "SL9MBFK93P"
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.taoong.musicvisualizer",
      team_id: "SL9MBFK93P",
      force: true
    )

    # Always build past whatever's actually on TestFlight, rather than
    # trusting the local pbxproj's CURRENT_PROJECT_VERSION — local tracking
    # (npm's cap:bump-build) can drift from reality whenever a build is
    # reverted/retried locally without ever reaching Apple, which otherwise
    # risks re-uploading a build number Apple already has (silently accepted
    # at upload time, then bounced later during async processing).
    latest = latest_testflight_build_number(api_key: api_key, app_identifier: "com.taoong.musicvisualizer")
    increment_build_number(build_number: latest + 1, xcodeproj: "App.xcodeproj")

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      output_directory: "./build"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
